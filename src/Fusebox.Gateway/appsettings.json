{
  // Structured JSON logs, one object per line, with scopes (such as TenantId) included.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    },
    "Console": {
      "FormatterName": "json",
      "FormatterOptions": {
        "IncludeScopes": true,
        "UseUtcTimestamp": true,
        "TimestampFormat": "o"
      }
    }
  },

  "AllowedHosts": "*",

  "Fusebox": {
    "Gateway": {
      "MaxRequestBodyBytes": 1048576,
      "MaxCapturedResponseBytes": 4194304,
      "SettlementTimeout": "00:00:05"
    },

    "Budgeting": {
      "DefaultMaxOutputTokens": 4096
    },

    // InMemory works for one instance only. Use Redis whenever more than one gateway instance runs.
    "Enforcement": {
      "Store": "InMemory",
      "SettlementGrace": "00:10:00",
      "Redis": {
        "ConnectionString": "",
        "KeyPrefix": "fusebox",
        "CommandTimeoutMilliseconds": 200
      }
    },

    // Where tenants and prices come from. "Configuration" reads the "Catalog" section below (development, tests).
    // "Postgres" reads the tenants and model_prices tables, the source of truth in production; the gateway
    // creates them on startup unless ApplySchemaOnStartup is false. Supply the connection string through
    // an environment variable (Fusebox__CatalogSource__Postgres__ConnectionString), never a committed file.
    // The catalog is reloaded every RefreshInterval. With the Redis store, instances also share it through Redis and
    // pick up a change published by another instance within SyncInterval.
    "CatalogSource": {
      "Kind": "Configuration",
      "RefreshInterval": "00:05:00",
      "SyncInterval": "00:00:15",
      "Postgres": {
        "ConnectionString": "",
        "ApplySchemaOnStartup": true,
        "CommandTimeout": "00:00:10"
      }
    },

    // Request records: tenant, route, model, status, latency, tokens and cost (never prompts or responses).
    // "None" records nothing. "Postgres" hands each record to an in-memory queue that a background writer saves in
    // batches, so recording never adds latency. If the queue fills, new records are dropped and counted in the
    // fusebox.telemetry.dropped metric. Raw rows are kept RawRetention; per-minute and per-hour totals are kept longer.
    // Supply the connection string through an environment variable (Fusebox__Telemetry__Postgres__ConnectionString).
    "Telemetry": {
      "Store": "None",
      "QueueCapacity": 10000,
      "MaxBatchSize": 1000,
      "FlushInterval": "00:00:01",
      "MaxWriteAttempts": 8,
      "RawRetention": "30.00:00:00",
      "RollupInterval": "00:01:00",
      "MinuteRollupLookback": "00:15:00",
      "HourRollupLookback": "03:00:00",
      "Postgres": {
        "ConnectionString": "",
        "ApplySchemaOnStartup": true,
        "CommandTimeout": "00:00:10"
      }
    },

    // Anomaly detection: watches each tenant's calls on each route for sudden jumps in volume, spend, errors, latency
    // and tokens per request, and records what it finds in the anomalies table. Off by default. It reads the per-minute
    // totals telemetry keeps, so it needs Telemetry:Store to be Postgres. Lag must be longer than the telemetry
    // RollupInterval. The settings below are the defaults; see docs/benchmarks/anomaly-detection.md for what they achieve.
    "Detection": {
      "Enabled": false,
      "EvaluationInterval": "00:01:00",
      "Lag": "00:02:00",
      "WindowMinutes": 5,
      "MinRequestsInWindow": 20,
      "FireRatio": 4,
      "ClearRatio": 2,
      "CalmEvaluationsToClear": 3,
      "Cooldown": "00:15:00"
    },

    // Diagnosis: when detection finds an anomaly, works out what changed (exact arithmetic on the per-minute totals:
    // calls, tokens per call, model mix, price) and writes a plain-English explanation into anomaly_diagnoses. Off by
    // default, and it needs Detection:Enabled. The explanation comes from a fixed template. Set NarratorEnabled to have
    // an LLM write it instead: it is sent only aggregated numbers (never prompts, responses or tenant names), its answer
    // is checked against the evidence, and the template is used if it is slow, wrong or over the monthly limit.
    // Supply the LLM key through an environment variable (Fusebox__Diagnosis__Llm__ApiKey). BaseUrl can point at Fusebox
    // itself, so these calls are budgeted and recorded like any other tenant's.
    "Diagnosis": {
      "Enabled": false,
      "Interval": "00:00:30",
      "BeforeMinutes": 60,
      "MaxAnomalyAge": "01:00:00",
      "NarratorEnabled": false,
      "MaxNarrationsPerMonth": 300,
      "NarratorTimeout": "00:00:15",
      "Llm": {
        "BaseUrl": "",
        "Path": "v1/chat/completions",
        "Model": "",
        "ApiKey": "",
        "MaxOutputTokens": 500
      }
    },

    // Vendors that keep failing are cut off: after FailureThreshold failed calls in a row (a 5xx answer, or no answer) calls
    // to that vendor are refused at once with a 503, without holding budget, and after OpenFor one call is let through to
    // see whether it is back. Each vendor is judged separately. Calls are never retried, because a call the vendor already
    // started would be billed twice. A critical alert is raised when a vendor is cut off and resolved when it recovers.
    "Upstream": {
      "Breaker": {
        "Enabled": true,
        "FailureThreshold": 5,
        "OpenFor": "00:00:30"
      }
    },

    // Repeated requests: a request is marked as a repeat if the same tenant sent an identical one to the same route in the
    // last Window, or the client says it is retrying (a retry count above zero in one of RetryHeaders). That is the usual
    // shape of a retry loop, and Detection watches the share of calls that repeat. Only a fingerprint of each request is kept,
    // in memory, never the request. With several gateway instances a retry that lands on another one is missed.
    "RepeatDetection": {
      "Enabled": true,
      "Window": "00:01:00",
      "MaxTracked": 50000
    },

    // Metrics: the gateway always counts requests, latency, refusals, spend and its own health, and pushes them over
    // OpenTelemetry (OTLP/HTTP) when OtlpEndpoint is set. Prometheus accepts that at /api/v1/otlp/v1/metrics when it
    // is started with --web.enable-otlp-receiver. Labels are only route, outcome and reason, never tenant or model.
    "Observability": {
      "OtlpEndpoint": "",
      "ExportInterval": "00:00:15"
    },

    // The admin API: tenants, budgets, keys and prices, plus open anomalies and alerts, under /admin with Swagger UI at
    // /admin/swagger. Off by default, and when off the routes do not exist. It needs CatalogSource:Kind = Postgres.
    // Callers send the admin key in the X-Admin-Key header. Configure only its SHA-256 hash, through an environment
    // variable (Fusebox__Admin__ApiKeyHash), and keep the API on a private network: it has one shared key and no login.
    "Admin": {
      "Enabled": false,
      "ApiKeyHash": ""
    },

    // Alerts. Off by default; it needs Telemetry:Store = Postgres, because every alert is saved there before it is sent and is
    // retried until the channel confirms it. Critical alerts page through PagerDuty, the rest go to Slack, and Webhook is a
    // generic extra. Supply secrets through environment variables (Fusebox__Alerting__PagerDuty__RoutingKey and so on).
    // Heartbeat pings an outside monitor (for example Healthchecks.io) while alert delivery is alive, so silence means trouble.
    "Alerting": {
      "Enabled": false,
      "Routing": {
        "Critical": [ "pagerduty" ],
        "Warning": [ "slack" ],
        "Info": [ "slack" ]
      },
      "CriticalCooldown": "00:05:00",
      "WarningCooldown": "00:15:00",
      "PagerDuty": { "RoutingKey": "" },
      "Slack": { "WebhookUrl": "" },
      "Webhook": { "Url": "", "BearerToken": "" },
      "Heartbeat": { "Url": "", "Interval": "00:01:00" }
    },

    // Tenants are added per environment, see appsettings.Development.json for the shape. A tenant can also have
    // "PriceMultiplier" (0.85 means it pays 85% of list price; 1 is list price) and "ModelPrices", rates negotiated for
    // particular models that replace the list price for that tenant. With a Postgres catalog, set both through the admin API.
    // Model prices below are EXAMPLES. Check them against your vendor's current pricing.
    "Catalog": {
      "Tenants": {},
      "Models": {
        "gpt-4o-mini": {
          "InputUsdPerMillionTokens": 0.15,
          "OutputUsdPerMillionTokens": 0.60
        }
      }
    },

    // Vendor API keys. Supply them through environment variables, for example
    // Fusebox__Upstreams__Keys__openai, never in a committed file.
    "Upstreams": {
      "Keys": {}
    }
  },

  "ReverseProxy": {
    "Routes": {
      "openai-chat": {
        "ClusterId": "openai",
        "Match": {
          "Path": "/openai/v1/chat/completions",
          "Methods": [ "POST" ]
        },
        "Transforms": [
          { "PathRemovePrefix": "/openai" }
        ],
        "Metadata": {
          "Fusebox.Protocol": "openai-chat"
        }
      }
    },
    "Clusters": {
      "openai": {
        "Destinations": {
          "primary": { "Address": "https://api.openai.com/" }
        },
        "Metadata": {
          "Fusebox.UpstreamKey": "openai"
        }
      }
    }
  }
}
