    {
      "type": "table",
      "title": "Notifications and whether they arrived, last 24 hours",
      "description": "Every alert is saved before it is sent and retried until the channel confirms it.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "rawSql": "SELECT COALESCE(sent_at, created_at) AS \"When\",\n       channel AS \"Channel\",\n       event AS \"Event\",\n       severity AS \"Severity\",\n       status AS \"Status\",\n       attempts AS \"Attempts\",\n       last_error AS \"Last problem\"\nFROM alert_deliveries\nWHERE created_at >= now() - interval '1 day'\nORDER BY created_at DESC\nLIMIT 100",
          "format": "table",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "editorMode": "code",
          "rawQuery": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "When"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "id": 3,
      "gridPos": {
        "x": 0,
